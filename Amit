<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Amit Trading</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial,sans-serif;
}

body{
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:20px;
  color:white;
  background:linear-gradient(135deg,#0f172a,#1e3a8a);
}

.container{
  width:100%;
  max-width:500px;
  padding:40px 25px;
  text-align:center;
  border-radius:25px;
  background:rgba(255,255,255,.10);
  backdrop-filter:blur(15px);
  border:1px solid rgba(255,255,255,.2);
  box-shadow:0 20px 50px rgba(0,0,0,.3);
}

.logo{
  width:90px;
  height:90px;
  margin:0 auto 20px;
  border-radius:50%;
  background:white;
  color:#1e3a8a;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:28px;
  font-weight:bold;
}

h1{
  font-size:32px;
  margin-bottom:12px;
}

.subtitle{
  color:#dbeafe;
  font-size:16px;
  line-height:1.6;
  margin-bottom:28px;
}

.features{
  text-align:left;
  margin-bottom:30px;
}

.feature{
  padding:14px;
  margin-bottom:10px;
  border-radius:12px;
  background:rgba(255,255,255,.08);
}

.telegram-btn{
  display:block;
  width:100%;
  padding:16px;
  border-radius:14px;
  background:#229ED9;
  color:white;
  text-decoration:none;
  font-size:18px;
  font-weight:bold;
  box-shadow:0 8px 20px rgba(34,158,217,.35);
}

.telegram-btn:hover{
  background:#168ac0;
  transform:translateY(-3px);
}

.note{
  margin-top:22px;
  color:#cbd5e1;
  font-size:12px;
  line-height:1.5;
}

footer{
  margin-top:25px;
  color:#94a3b8;
  font-size:12px;
}
</style>
</head>

<body>

<div class="container">

  <div class="logo">AT</div>

  <h1>Amit Trading</h1>

  <p class="subtitle">
    Welcome to Amit Trading.<br>
    Join our Telegram channel for the latest updates and information.
  </p>

  <div class="features">
    <div class="feature">📢 Latest Updates</div>
    <div class="feature">📊 Trading Information</div>
    <div class="feature">⚡ Fast Notifications</div>
    <div class="feature">🔔 Stay Connected</div>
  </div>

  <a
    class="telegram-btn"
    href="https://t.me/+2b0sH1GwCGkyZmRl"
    target="_blank">
    ✈️ Join Telegram
  </a>

  <p class="note">
    By joining, you agree to receive updates through our Telegram channel.
  </p>

  <footer>
    © 2026 Amit Trading. All Rights Reserved.
  </footer>

</div>

</body>
</html>
